# Copy this file to .env.local and fill in real values.
# See docs/EdMar_Attendance_Blueprint_and_Cursor_Build_Spec.md section 10.

# Supabase project URL (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Never put the service-role key here or
# anywhere in browser-reachable code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL this app is served from in this environment (used for auth
# redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
